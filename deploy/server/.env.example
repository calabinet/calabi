# Copy to .env and fill in. `docker compose up -d` reads it.

# How devices reach this server: its public DNS name or IP address.
CALABI_PUBLIC_HOST=vpn.example.com

# The token for the coordinator's admin API, which `calabi-coord invite`,
# `authkey` and `device` use. It never leaves this machine; make it long:
#   openssl rand -hex 32
CALABI_ADMIN_TOKEN=

# HTTP endpoints get names under this domain (u000001.endpoints.example.com). Point
# a wildcard DNS record for it (*.endpoints.example.com) at this server. HTTP
# endpoints need it; leave it empty if you use the mesh and TCP/UDP endpoints only.
CALABI_TUNNEL_DOMAIN=

# Optional.
# CALABI_VERSION=latest          # the image tag, e.g. 1.13.0
# CALABI_DEVICE_LIMIT=0          # the most devices one network may have; 0 = no limit
# CALABI_NODE_NAME=calabi-server # this server's name in the edge's logs
# CALABI_TZ=UTC                  # the time zone logs and invite expiries are shown in
