SetFont /LANG=${LANG_SIMPCHINESE} "Microsoft YaHei UI" 9

LangString addOrReinstall ${LANG_SIMPCHINESE} "添加／重新安装组件"
LangString alreadyInstalled ${LANG_SIMPCHINESE} "已安装"
LangString alreadyInstalledLong ${LANG_SIMPCHINESE} "已安装 ${PRODUCTNAME} ${VERSION}。请选择操作，然后点击“下一步”。"
LangString appRunning ${LANG_SIMPCHINESE} "${PRODUCTNAME} 正在运行，请先退出后重试。"
LangString appRunningOkKill ${LANG_SIMPCHINESE} "${PRODUCTNAME} 正在运行！$\n点击“确定”结束程序。"
LangString chooseMaintenanceOption ${LANG_SIMPCHINESE} "请选择维护操作。"
LangString choowHowToInstall ${LANG_SIMPCHINESE} "请选择 ${PRODUCTNAME} 的安装方式。"
LangString createDesktop ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString dontUninstall ${LANG_SIMPCHINESE} "升级（保留数据）"
LangString dontUninstallDowngrade ${LANG_SIMPCHINESE} "保留数据（此安装器不允许直接降级）"
LangString failedToKillApp ${LANG_SIMPCHINESE} "无法结束 ${PRODUCTNAME}，请手动退出后重试。"
LangString installingWebview2 ${LANG_SIMPCHINESE} "正在安装 WebView2…"
LangString newerVersionInstalled ${LANG_SIMPCHINESE} "已安装较新版本的 ${PRODUCTNAME}，继续安装将降级应用。保留数据选项会替换程序并保留登录、设备身份和设置；先卸载则会移除当前程序。"
LangString older ${LANG_SIMPCHINESE} "较旧"
LangString olderOrUnknownVersionInstalled ${LANG_SIMPCHINESE} "检测到已安装 ${PRODUCTNAME}。建议选择“升级（保留数据）”，保留登录、设备身份和设置。仅在需要先移除当前程序时，选择“先卸载再安装”。"
LangString silentDowngrades ${LANG_SIMPCHINESE} "此安装器不允许静默降级，请使用安装界面。$\n"
LangString unableToUninstall ${LANG_SIMPCHINESE} "无法卸载！"
LangString uninstallApp ${LANG_SIMPCHINESE} "卸载 ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SIMPCHINESE} "先卸载再安装"
LangString unknown ${LANG_SIMPCHINESE} "未知"
LangString webview2AbortError ${LANG_SIMPCHINESE} "WebView2 安装失败，应用无法运行。请重启安装器后重试。"
LangString webview2DownloadError ${LANG_SIMPCHINESE} "WebView2 下载失败：$0"
LangString webview2DownloadSuccess ${LANG_SIMPCHINESE} "WebView2 安装程序下载成功"
LangString webview2Downloading ${LANG_SIMPCHINESE} "正在下载 WebView2 安装程序…"
LangString webview2InstallError ${LANG_SIMPCHINESE} "WebView2 安装失败，退出码：$1"
LangString webview2InstallSuccess ${LANG_SIMPCHINESE} "WebView2 安装成功"
LangString deleteAppData ${LANG_SIMPCHINESE} "删除应用数据（登录信息、设备身份和设置）"

LangString calabiClosingDesktop ${LANG_SIMPCHINESE} "正在关闭 Calabi 桌面程序和文件收发进程…"
LangString calabiCloseDesktopFailed ${LANG_SIMPCHINESE} "无法关闭 Calabi 桌面程序或文件收发进程，尚未停止后台服务。请退出 Calabi 后重试。$\r$\n$\r$\n技术详情：$R1"
LangString calabiForeignService ${LANG_SIMPCHINESE} "检测到其他安装方式创建的 Calabi 服务：$R0"
LangString calabiForeignServiceError ${LANG_SIMPCHINESE} "此服务属于另一份 Calabi 安装：$\r$\n$R0$\r$\n$\r$\n请先用 calabi daemon uninstall 移除该服务，再重新安装。"
LangString calabiStoppingService ${LANG_SIMPCHINESE} "正在停止 Calabi 后台服务…"
LangString calabiFileBusy ${LANG_SIMPCHINESE} "Calabi 程序文件仍被占用，已停止安装。"
LangString calabiFileBusyError ${LANG_SIMPCHINESE} "Calabi 程序文件仍被占用，无法替换。请关闭仍在运行的 Calabi 命令行或文件工具后重试。已尝试恢复原后台服务。"
LangString calabiRegisteringService ${LANG_SIMPCHINESE} "正在注册 Calabi 后台服务…"
LangString calabiServiceInstallResult ${LANG_SIMPCHINESE} "后台服务注册返回码：$R0"
LangString calabiServiceNotRegistered ${LANG_SIMPCHINESE} "Calabi 后台服务尚未注册。"
LangString calabiServiceInstallFailed ${LANG_SIMPCHINESE} "无法注册后台服务。请解决下述问题后重试安装。$\r$\n$\r$\n技术详情：$R1"
LangString calabiConfiguringFirewall ${LANG_SIMPCHINESE} "正在配置文件接收防火墙规则…"
LangString calabiFirewallFailed ${LANG_SIMPCHINESE} "无法配置文件接收防火墙规则。请检查防火墙策略后重试。$\r$\n$\r$\n技术详情：$R1"
LangString calabiServiceStartResult ${LANG_SIMPCHINESE} "后台服务启动返回码：$R0"
LangString calabiServiceNotStarted ${LANG_SIMPCHINESE} "Calabi 后台服务未能启动。"
LangString calabiServiceStartFailed ${LANG_SIMPCHINESE} "后台服务启动失败。请在 Windows 服务管理器中启动 Calabi，或重试安装。$\r$\n$\r$\n技术详情：$R1"
LangString calabiRemovingFirewall ${LANG_SIMPCHINESE} "正在移除文件接收防火墙规则…"
LangString calabiRemoveFirewallFailed ${LANG_SIMPCHINESE} "无法移除文件接收防火墙规则。请检查防火墙策略后重试卸载。$\r$\n$\r$\n技术详情：$R1"
LangString calabiRemovingService ${LANG_SIMPCHINESE} "正在移除 Calabi 后台服务…"

