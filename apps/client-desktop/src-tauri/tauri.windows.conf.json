{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "binaries/calabi.exe": "calabi.exe",
      "../../client/internal/status/ui/public/ssh-notices.txt": "ssh-notices.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "English": "nsis-languages/English.nsh",
          "SimpChinese": "nsis-languages/SimpChinese.nsh"
        }
      }
    }
  }
}
